const SKILL_KEYS = ["receive_each", "prep", "case_receive", "case_to_cage", "dock_ob", "sort", "stow", "pick", "sbc", "op", "unbind", "pallet_receive", "yard_safety", "gtdr", "problem_solve", "cubiscan", "learning_amb", "carton_pred", "high_reach", "cc", "bind", "hazmat", "food_safety", "raspador"];
const SKILL_LABELS = {"receive_each": "Receive each", "prep": "Prep", "case_receive": "Case Receive", "case_to_cage": "Case to Cage", "dock_ob": "Dock OB", "sort": "Sort", "stow": "Stow", "pick": "Pick", "sbc": "SBC", "op": "OP", "unbind": "Unbind Hierarchy", "pallet_receive": "🚨 Pallet Receive", "yard_safety": "🚨 YARD SAFETY", "gtdr": "🚨 GTDR", "problem_solve": "🚨 Problem Solve", "cubiscan": "🚨 Cubiscan", "learning_amb": "🚨 Learning Ambassador", "carton_pred": "Carton PrEditor", "high_reach": "🚨 High Reach", "cc": "CC", "bind": "Bind Hierarchy", "hazmat": "Hazmat", "food_safety": "Food safety", "raspador": "🚨 Raspador"};
const TOTAL = 398;

function applyFilters(){
  const dept = document.getElementById('fDept').value;
  const mgr = document.getElementById('fMgr').value;
  const shift = document.getElementById('fShift').value;

  let filtered = EMP.filter(e => {
    if(dept !== 'all' && e.d !== dept) return false;
    if(mgr !== 'all' && e.m !== mgr) return false;
    if(shift !== 'all' && e.s !== shift) return false;
    return true;
  });

  const n = filtered.length;
  document.getElementById('filterResult').textContent = 'Mostrando: ' + n + ' de ' + TOTAL;

  // Update skill cards
  const cards = document.querySelectorAll('.crit-card');
  let idx = 0;
  const sorted = SKILL_KEYS.slice().sort((a,b) => {
    const ca = filtered.filter(e=>e[a]===1).length;
    const cb = filtered.filter(e=>e[b]===1).length;
    return cb - ca;
  });

  cards.forEach((card, i) => {
    const sk = card.getAttribute('data-skill');
    if(!sk) return;
    const count = filtered.filter(e => e[sk] === 1).length;
    const pct = n > 0 ? (count/n*100).toFixed(1) : '0.0';
    const miss = n - count;
    const color = pct >= 70 ? 'var(--green)' : pct >= 40 ? 'var(--amber)' : 'var(--red)';
    card.style.borderTopColor = color;
    card.querySelector('.pct').textContent = pct + '%';
    card.querySelector('.pct').style.color = color;
    card.querySelector('.miss').textContent = count + ' de ' + n + ' — faltan ' + miss;
  });

  updateExplorer();
}

function resetFilters(){
  document.getElementById('fDept').value = 'all';
  document.getElementById('fMgr').value = 'all';
  document.getElementById('fShift').value = 'all';
  applyFilters();
}

function getFiltered(){
  const dept = document.getElementById('fDept').value;
  const mgr = document.getElementById('fMgr').value;
  const shift = document.getElementById('fShift').value;
  return EMP.filter(e => {
    if(dept !== 'all' && e.d !== dept) return false;
    if(mgr !== 'all' && e.m !== mgr) return false;
    if(shift !== 'all' && e.s !== shift) return false;
    return true;
  });
}

function updateExplorer(){
  const sk = document.getElementById('skillExplorer').value;
  const container = document.getElementById('explorerResult');
  if(!sk){ container.innerHTML = 'Selecciona una habilidad para ver el detalle.'; return; }

  const filtered = getFiltered();
  const has = filtered.filter(e => e[sk] === 1);
  const hasnt = filtered.filter(e => e[sk] === 0);

  let html = '<div style="margin-bottom:10px"><strong>' + SKILL_LABELS[sk] + '</strong>: ' + has.length + ' de ' + filtered.length + ' (' + (filtered.length>0?(has.length/filtered.length*100).toFixed(1):'0') + '%)</div>';

  html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">';
  html += '<div><h4 style="font-size:13px;color:var(--green);margin:0 0 8px">✅ Certificados (' + has.length + ')</h4><div style="display:flex;flex-wrap:wrap;gap:4px">';
  has.sort((a,b) => a.l.localeCompare(b.l)).forEach(e => {
    html += '<span style="background:var(--green-soft);padding:3px 8px;border-radius:5px;font-size:11px;font-family:monospace">' + e.l + '</span>';
  });
  html += '</div></div>';

  html += '<div><h4 style="font-size:13px;color:var(--red);margin:0 0 8px">❌ Sin certificar (' + hasnt.length + ')</h4><div style="display:flex;flex-wrap:wrap;gap:4px">';
  hasnt.sort((a,b) => a.l.localeCompare(b.l)).forEach(e => {
    html += '<span style="background:var(--red-soft);padding:3px 8px;border-radius:5px;font-size:11px;font-family:monospace">' + e.l + '</span>';
  });
  html += '</div></div></div>';

  container.innerHTML = html;
}
