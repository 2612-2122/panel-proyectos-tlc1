<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Panel Ejecutivo de Habilidades Criticas — TLC1</title>
<style>
 
:root{--bg:#F3F5F7;--surface:#FFFFFF;--surface-alt:#ECF0F3;--ink:#0E2233;--ink-soft:#54697A;--ink-faint:#93A3AF;--navy:#0B3A5B;--navy-deep:#062A44;--steel:#2E7DA6;--amber:#EFA333;--amber-soft:#FCEACB;--red:#D6473F;--red-soft:#FBDEDC;--green:#1E9E6C;--green-soft:#D9F0E5;--border:#E0E5EA;--shadow:0 1px 2px rgba(14,34,51,.04),0 6px 20px rgba(14,34,51,.06);} 
*{box-sizing:border-box;}html{scroll-behavior:smooth;} 
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;} 
header.top{background:linear-gradient(120deg,var(--navy-deep),var(--navy) 70%);color:#fff;padding:26px clamp(18px,4vw,48px);display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;border-bottom:4px solid var(--amber);} 
.brand{display:flex;align-items:center;gap:16px;} 
.brand-mark{width:54px;height:54px;border-radius:10px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.25);display:flex;align-items:center;justify-content:center;font-family:monospace;font-weight:600;font-size:13px;} 
h1{font-weight:800;font-size:clamp(20px,2.4vw,28px);margin:0 0 4px 0;letter-spacing:-.2px;} 
header.top p{margin:0;color:#BFD3E1;font-size:14px;} 
.header-meta{display:flex;gap:28px;flex-wrap:wrap;} 
.header-meta .stat{text-align:right;} 
.header-meta .stat .num{font-family:monospace;font-weight:600;font-size:22px;display:block;} 
.header-meta .stat .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#AFC6D6;} 
main{max-width:1320px;margin:0 auto;padding:28px clamp(16px,4vw,48px) 80px;} 
section{margin-top:34px;} 
.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:14px;} 
.section-head h2{font-weight:800;font-size:20px;margin:0;} 
.section-head .eyebrow{font-family:monospace;font-size:11px;color:var(--steel);text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:4px;} 
.section-head p.desc{margin:2px 0 0;color:var(--ink-soft);font-size:13.5px;max-width:640px;} 
.filterbar{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px 20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;box-shadow:var(--shadow);} 
.filterbar .flabel{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-faint);display:block;margin-bottom:4px;} 
.filter-group{display:flex;flex-direction:column;} 
.filterbar select{font-family:system-ui,sans-serif;font-size:13.5px;font-weight:600;color:var(--ink);border:1.5px solid var(--border);background:var(--surface-alt);padding:8px 12px;border-radius:9px;min-width:150px;} 
#resetBtn{font-weight:700;font-size:13px;color:var(--navy);background:#fff;border:1.5px solid var(--navy);border-radius:9px;padding:8px 14px;cursor:pointer;} 
.filter-result{margin-left:auto;font-family:monospace;font-size:13px;color:var(--steel);font-weight:600;background:#EAF3F8;padding:8px 14px;border-radius:9px;white-space:nowrap;} 
.crit-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;} 
.crit-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px 18px;box-shadow:var(--shadow);border-top:3px solid var(--steel);cursor:default;} 
.crit-card.clickable{cursor:pointer;transition:transform .1s;} 
.crit-card.clickable:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(14,34,51,.12);} 
.crit-card h3{font-size:14px;margin:0 0 8px;color:var(--ink);} 
.crit-card .pct{font-family:monospace;font-weight:600;font-size:26px;color:var(--ink);} 
.crit-card .miss{font-size:12px;color:var(--ink-soft);margin-top:4px;} 
.crit-card .click-hint{font-size:10px;color:var(--steel);margin-top:6px;font-style:italic;} 
.grid-2{display:grid;grid-template-columns:1.15fr .85fr;gap:18px;align-items:stretch;} 
.panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:20px 22px;box-shadow:var(--shadow);} 
h4.chart-title{font-size:14.5px;margin:0 0 2px;color:var(--ink);} 
p.chart-sub{font-size:12px;color:var(--ink-soft);margin:0 0 14px;} 
.pie-container{display:flex;align-items:center;gap:24px;flex-wrap:wrap;justify-content:center;} 
.pie-chart{width:220px;height:220px;border-radius:50%;position:relative;} 
.pie-legend{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;} 
.pie-legend li{display:flex;align-items:center;gap:8px;font-size:12px;} 
.pie-legend .dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;} 
.pie-legend .lbl{color:var(--ink);font-weight:600;} 
.pie-legend .val{color:var(--ink-soft);font-family:monospace;font-size:11px;} 
.bar-chart{display:flex;flex-direction:column;gap:8px;} 
.bar-row{display:flex;align-items:center;gap:8px;} 
.bar-label{width:120px;font-size:11px;font-weight:600;color:var(--ink);text-align:right;flex-shrink:0;} 
.bar-track{flex:1;height:20px;background:var(--surface-alt);border-radius:6px;overflow:hidden;} 
.bar-fill{height:100%;border-radius:6px;display:flex;align-items:center;padding-left:6px;} 
.bar-fill span{font-size:10px;font-weight:600;color:#fff;white-space:nowrap;} 
.bar-value{font-family:monospace;font-size:11px;color:var(--ink-soft);width:65px;text-align:left;flex-shrink:0;} 
.heatmap-panel{background:var(--navy-deep);border-radius:16px;padding:26px clamp(16px,3vw,30px) 22px;color:#fff;box-shadow:var(--shadow);} 
.heatmap-panel .section-head h2{color:#fff;} 
.heatmap-panel .section-head p.desc{color:#AFC6D6;} 
.heatmap-panel .eyebrow{color:var(--amber);} 
.heatmap-scroll{overflow-x:auto;padding-bottom:6px;} 
table.heatmap{border-collapse:separate;border-spacing:4px;width:100%;min-width:1200px;} 
table.heatmap th{font-family:monospace;font-weight:500;font-size:10px;color:#AFC6D6;text-transform:uppercase;padding:5px 3px;text-align:center;} 
table.heatmap th.rowlabel-head{text-align:left;} 
table.heatmap td.rowlabel{font-weight:700;font-size:14px;color:#fff;padding:10px 12px;white-space:nowrap;} 
table.heatmap td.rowlabel .n{display:block;font-family:monospace;font-weight:500;font-size:11px;color:#8FB0C6;} 
table.heatmap td.cell{border-radius:8px;text-align:center;padding:10px 4px;min-width:55px;font-family:monospace;font-weight:600;font-size:13px;} 
table.heatmap td.cell .cn{display:block;font-weight:500;font-size:9px;opacity:.85;margin-top:2px;} 
.heatmap-legend{display:flex;align-items:center;gap:10px;margin-top:16px;font-size:11.5px;color:#AFC6D6;} 
.heatmap-legend .scale{height:10px;width:160px;border-radius:6px;background:linear-gradient(90deg,#D6473F,#EFA333,#1E9E6C);} 
.explorer-controls{display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;margin-bottom:16px;} 
.explorer-controls select{font-family:system-ui,sans-serif;font-weight:600;font-size:13.5px;border:1.5px solid var(--border);background:var(--surface-alt);padding:9px 12px;border-radius:9px;min-width:220px;} 
.gap-summary{font-family:monospace;font-size:13px;color:var(--green);font-weight:600;background:var(--green-soft);padding:9px 14px;border-radius:9px;} 
table.gaptable{width:100%;border-collapse:collapse;font-size:13.5px;} 
table.gaptable thead th{text-align:left;font-family:monospace;font-size:11px;text-transform:uppercase;color:var(--ink-faint);border-bottom:2px solid var(--border);padding:8px 10px;} 
table.gaptable tbody td{padding:9px 10px;border-bottom:1px solid var(--border);} 
.pill{display:inline-block;font-size:11px;font-weight:600;padding:3px 9px;border-radius:20px;} 
.pill.Inbound{background:#DCEBFA;color:#0B5FA5;} 
.pill.Outbound{background:#F3E4FC;color:#7A3EBF;} 
.pill.ICQA{background:var(--green-soft);color:#137A51;} 
.table-scroll{max-height:360px;overflow-y:auto;border:1px solid var(--border);border-radius:10px;} 
.table-scroll thead th{position:sticky;top:0;background:#fff;} 
.insights-panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);padding:22px 26px;} 
.insight-list{list-style:none;margin:0;padding:0;display:grid;gap:14px;} 
.insight-list li{display:flex;gap:14px;align-items:flex-start;padding:14px 16px;background:var(--surface-alt);border-radius:10px;border-left:4px solid var(--steel);} 
.insight-list li.i-warn{border-left-color:var(--amber);} 
.insight-list li.i-crit{border-left-color:var(--red);} 
.insight-list li.i-good{border-left-color:var(--green);} 
.insight-list .itag{font-family:monospace;font-size:10.5px;font-weight:600;padding:4px 8px;border-radius:6px;background:#fff;color:var(--ink-soft);white-space:nowrap;text-transform:uppercase;border:1px solid var(--border);} 
.insight-list p{margin:0;font-size:13.8px;line-height:1.55;color:var(--ink);} 
.insight-list p b{color:var(--navy);} 
footer{text-align:center;color:var(--ink-faint);font-size:12px;padding:30px 20px 10px;} 
.modal-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);z-index:1000;justify-content:center;align-items:center;} 
.modal-overlay.active{display:flex;} 
.modal{background:#fff;border-radius:16px;padding:28px;max-width:750px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.3);position:relative;} 
.modal h3{margin:0 0 6px;font-size:18px;color:var(--navy);} 
.modal .modal-sub{font-size:13px;color:var(--ink-soft);margin:0 0 16px;} 
.modal .close-btn{position:absolute;top:16px;right:20px;font-size:24px;cursor:pointer;color:var(--ink-faint);background:none;border:none;} 
table.modal-table{width:100%;border-collapse:collapse;font-size:13px;} 
table.modal-table thead th{text-align:left;font-size:11px;text-transform:uppercase;color:var(--ink-faint);border-bottom:2px solid var(--border);padding:8px 10px;} 
table.modal-table tbody td{padding:8px 10px;border-bottom:1px solid var(--border);} 
.status-vigente{color:var(--green);font-weight:600;} 
.status-proximo{color:var(--amber);font-weight:600;} 
.status-vencido{color:var(--red);font-weight:600;} 
.status-retirado{color:#fff;font-weight:600;background:var(--red);padding:2px 8px;border-radius:4px;font-size:11px;} 
.status-apto{color:var(--green);font-weight:600;} 
.status-noapto{color:var(--red);font-weight:600;} 
.status-pd{color:var(--amber);font-weight:600;} 
.status-sin{color:var(--ink-faint);font-weight:600;} 
.pct-bar{display:inline-block;height:8px;border-radius:4px;margin-right:6px;vertical-align:middle;} 

</style>
</head>
<body>

<header class="top">
<div class="brand">
<div class="brand-mark">FCLM<br>TLC1</div>
<div>
<h1>Panel Ejecutivo de Habilidades Cr&iacute;ticas</h1>
<p>Facility&nbsp;Celaya&nbsp;&mdash;&nbsp;Learning&nbsp;TLC1</p>
</div>
</div>
<div class="header-meta">
<div class="stat"><span class="num">398</span><span class="lbl">Colaboradores</span></div>
<div class="stat"><span class="num">24</span><span class="lbl">Habilidades</span></div>
